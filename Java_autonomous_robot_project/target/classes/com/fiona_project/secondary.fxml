<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="8.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fiona_project.SecondaryController">
    <children>
        <Label text="Simulation" />
        <HBox spacing="8.0" alignment="CENTER">
            <children>
                <Button fx:id="startButton" text="Start" onAction="#onStart" />
                <Button fx:id="stepButton" text="Step" onAction="#onStep" />
                <Button fx:id="resetButton" text="Reset" onAction="#onReset" />
                <Button fx:id="backButton" text="Back" onAction="#switchToPrimary" />
            </children>
        </HBox>
        <Canvas fx:id="canvas" width="640" height="640" />
    </children>
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
</VBox>
